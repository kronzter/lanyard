{
  "name": "lanyard",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "forge:test": "cd packages/contracts && forge test",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm forge:test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": "prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scure/bip39": "2.4.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
